    "    info[\"stops\"] = vuelos[\"stops\"].mode()[0] if not vuelos[\"stops\"].mode().empty else None\n",
    "    info[\"class\"] = vuelos[\"class\"].mode()[0] if not vuelos[\"class\"].mode().empty else None\n",
